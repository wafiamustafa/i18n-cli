# Copy to .env and uncomment only the providers you want to configure.
# Keep these CLI secrets unprefixed: do not use VITE_, REACT_APP_, or NEXT_PUBLIC_.

# Official Google Cloud Translation (required for commercial Google translation)
# GOOGLE_API_KEY=your-google-cloud-api-key

# OpenAI (takes priority by default when configured; use --provider google to override)
# OPENAI_API_KEY=your-openai-api-key
